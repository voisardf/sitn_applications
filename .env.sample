PGDATABASE=sitn
PGUSER=sitn
PGHOST=127.0.0.1
PGPORT=5432
PGPASSWORD=sitn
PGSCHEMA=sitn_applications

TERRIS_USER=user
TERRIS_PASSWORD=password
TERRIS_HOST=server.ne.ch
TERRIS_PORT=1521
TERRIS_SERVICE=database

SECRET_KEY="the-top-secret-key-you-do-not-want-to-give-away"

IS_INTRANET=False
DOCKER_HOST=""
DOCKER_PORT=5300
DOCKER_BASE=apps
COMPOSE_PROJECT_NAME="sitn_apps"

NEARCH2_CONSULTATION=mount_to_nearch2
UPLOAD_DATA_PATH=/mnt/apps_upload
DATA_PATH=/mnt/apps_data

# Only for dev or local deployment - DELETE IF CONFIGURING THE PRODUCTION ENVIRONMENT

DEVELOPMENT_MODE=True
DEV_MAIL_ON=False
GDAL_PATH="C:/Program Files/GDAL/"
GDAL_LIBRARY_PATH="C:/Program Files/GDAL/gdalXXXX.dll"
GEOS_LIBRARY_PATH="C:/PostgreSQL/XXX/bin/libgeos_c.dll"

# end of dev env

# Only for prod or prepub
DOCKER_HOST=ssh://user@server.example.com

ALLOWED_HOSTS="example.com,example2.com"

# List of allowed origins, can be multiline
CORS_ALLOWED_ORIGINS="http://localhost:5173,
https://sitn.ne.ch"
EMAIL_HOST=smtp.example.com

# You can set your production base URL here like:
# ROOTURL="/apps"
ROOTURL=""

CSRF_COOKIE_DOMAIN="127.0.0.1"

# INTRANET ONLY
# Add an user here that has permission to see internal metadata
GEOSHOP_USER="user"
GEOSHOP_PASSWORD="password"

VCRON_URL="http://host:8001"
VCRON_USER="user"
VCRON_PASSWORD="password"

INFOLICA_API_URL="url/to/infolica/api/"

# For dev only, remote database to dump from
DEV_REMOTE_PGDATABASE=database
DEV_REMOTE_PGUSER=sample
DEV_REMOTE_PGHOST=sample.ne.ch
DEV_REMOTE_PGPORT=5432
DEV_REMOTE_PGPASSWORD=sample

DOTNETID_SERVER_URL=https://dotnetiddev.ne.ch
DOTNETID_CLIENT_ID=client-id
DOTNETID_CLIENT_SECRET=client-secret
DOTNETID_EXTRA_ATTRIBUTES_PREFIX=clientname

# --- sene_chantiers -------------------------------------------------------
# All five have working defaults in settings.py; set them only to override.

# PDF rendering microservice (sitn/docker-weasyprint + fonts). The URL
# differs per context, like PGHOST: http://localhost:5001 from the host,
# http://host.docker.internal:5001 from a container on Docker Desktop,
# and the container's own name when it shares the sitn_pdf network on a
# server -- see docker-compose.yml. Pointing at a published port on the
# Docker host does NOT work on the SITN servers: firewalld refuses
# traffic from the bridge networks to host ports.
# NB the upstream image ships no fonts and segfaults without them.
SENE_CHANTIERS_WEASYPRINT_URL="http://localhost:5001"

# Advisory budget for one notification email (PDF + selected photos).
# Exceeding it warns the inspector rather than blocking the send.
SENE_CHANTIERS_EMAIL_ATTACHMENTS_MAX_SIZE_MB=5

# Hard per-photo limit on upload, refused outright.
SENE_CHANTIERS_PHOTO_MAX_SIZE_MB=10

# Weekly deadline digest: 0 = Monday, and the hour in 24h local time.
SENE_CHANTIERS_DEADLINE_DIGEST_DAY_OF_WEEK=0
SENE_CHANTIERS_DEADLINE_DIGEST_HOUR=8
